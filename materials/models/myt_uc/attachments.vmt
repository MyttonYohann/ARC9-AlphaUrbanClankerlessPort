VertexLitGeneric
{
$basetexture "models\myt_uc\attachments"
$bumpmap 			"models\myt_uc\attachments_normal"
$phongexponenttexture 	"models\myt_uc\_detail\exponent"

$phong 1
$phongboost "20"
$phongexponent "16"	
$phongfresnelranges "[.75 1.5 3]"
$phongalbedotint 1
$normalmapalphaenvmapmask "1"
$envmap env_cubemap
$envmapfresnel 1
$envmaptint "[.1 .1 .1]"

$detail "models\myt_uc\_detail\dt_metal1"
$detailscale 8
$detailblendfactor 0.8
}


